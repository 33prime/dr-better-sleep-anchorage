# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Pick ONE based on how you run dev:
#   - `npm run dev`     → use VITE_ANTHROPIC_API_KEY (direct browser call)
#   - `netlify dev`     → use ANTHROPIC_API_KEY (proxies via /api/chat)
VITE_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (project: dr-never-snore). URL + publishable/anon key are safe for the
# client bundle; RLS is the security boundary. netlify/edge-functions/chat.ts
# also reads these two (Deno.env picks up the same names under `netlify dev`)
# to verify the caller's session before proxying to Anthropic — if your
# Netlify deploy doesn't expose VITE_-prefixed vars to Edge Functions, mirror
# them as SUPABASE_URL / SUPABASE_ANON_KEY too.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Postgres password — CLI/db access only, never shipped to the client.
SUPABASE_DB_PASSWORD=
# Server-side only — seed scripts & admin ops. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Demo account for investor walkthroughs (created by scripts/seed-demo.mjs).
# VITE_ copies are the same credentials, mirrored so Auth.tsx's "Explore the
# demo" button can sign in client-side.
DEMO_EMAIL=
DEMO_PASSWORD=
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
