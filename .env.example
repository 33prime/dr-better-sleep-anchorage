# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Pick ONE based on how you run dev:
#   - `npm run dev`     → use VITE_ANTHROPIC_API_KEY (direct browser call)
#   - `netlify dev`     → use ANTHROPIC_API_KEY (proxies via /api/chat)
VITE_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (project: dr-never-snore). URL + publishable/anon key are safe for the
# client bundle; RLS is the security boundary.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Postgres password — CLI/db access only, never shipped to the client.
SUPABASE_DB_PASSWORD=
